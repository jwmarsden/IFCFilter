# ifcfilter split rules. Copy to rules.txt and change to suit the models. One rule a line: an action, a space, then its text.
# Lines starting with # are comments.

# Where a thing goes, by text its family's name holds:
# keep-largest  the largest solid is the thing, and the rest is detail inside it, for the hidden file
# physical      transparent, but really there, so not an envelope
# envelope      opaque, but not really there, so an envelope
# hidden        really there, but out of sight, so all of it goes in the hidden file
keep-largest HUME SLAB
physical Grating
physical Stair
envelope Clearance
hidden Pile Cap
# Tree root balls are separate children in the landscape export.
hidden-if [Generic].[Graphic3d].User Label=Rootball
# A property on an assembly can hide its entire hierarchy, including its geometry-bearing children.
hidden-tree-if Corridor Data.Element_Description=Shared Cell: Footing Type 3

# For when the family doesn't say what a thing is, as with a road's meshes, by a property's value: SET.PROPERTY=VALUE
# keep-if takes precedence over hidden, envelope, keep-largest and transparency rules.
keep-if Corridor Data.Feature_Definition=Pavement Type FP2-Layer1
hidden-if Corridor_Mesh_ID.Asset_Identifier_Label=Subbase
envelope-if Corridor_Mesh_ID.Asset_Identifier_Label=Vehicle Envelope
# An assembly with this property keeps its big parts; those under a quarter of its size go in the hidden file
hidden-small-parts-if Corridor Data.IsSignFace=Yes
# An assembly with this property moves forward by this many millimetres, off its post
forward-if Corridor Data.IsSignFace=Yes 25
# A body within this many metres of the world's 0,0 is left out, when nearly all the model is far from it:
# a dummy an exporter left there, such as an empty surface
cull-at-origin 10
# A site drawn see-through in the federation file, from 0 (as it is) to 1 (invisible): SITEID TRANSPARENCY
transparent-site ABC123456 0.5
# One element per site across the models of a combined file: the XY model's keeps its own, and the others' bodies go in it
join-across-models ABC XY

# Where the models keep their asset data. Anything left out is left alone: without site-set and site-id,
# nothing merges by site.
# site-set           a property set holding the site ID; the first is preferred where an element has several
# site-id            the site ID property
# asset-type         corrected to what the site ID starts with
# asset-component    an asset's parts are described as this
# design-set         a property set holding the design tag, for elements with no site ID; first preferred
# design-tag         the design tag property
# mark-set           a property set holding the mark that tells pieces apart; first preferred
# mark               the mark property: elements with a design tag but different marks are apart
# zone-property      an element's zone, in any set, for the IFCFilter set; the model's file name says it if that doesn't
# zone               one zone, a line each; anything else, such as a group of zones, isn't one
# location-property  an element's location, in any set, for the IFCFilter set
# discipline-property  an element's discipline, in the IFC_Filter or project set, for the viewing caches' filters
# hierarchy-set      the set the workbook's Hierarchy fields are read from, by the same names
# hierarchy-source   FIELD PROPERTY: a Hierarchy field read from a differently named property in that set
# merge-runs         an asset type whose placeholder site IDs are merged as runs: parts that touch, within 5 cm
# site-from-assembly an assembly's IFC class, or *: its parts with no site ID take the assembly's, as a Revit
#                    stair's runs and landings, which are its shape, have none and the stair has it
# quantity-set       sizes are worked out for a merged asset as a whole in this set, as these three:
# quantity-length, quantity-width, quantity-height
# cull-set           left out of every output once merging has used it
# duplicate-set      what it repeats from other sets on the same elements is left out of it
# project-set        the set holding the next two
# project-long-name  the project's long name, as most of the model has it
# project-code       the project package's code, for the manifests
# building-name      the building's name, as most of the model has it
# site-name          the site's name, rather than Revit's "Default"
site-set Asset
site-id SiteID
asset-type AssetType
asset-component AssetComponent
design-set Quantities
design-tag DesignTag
mark-set Identity
mark Mark
zone-property Zone
zone NORTH
zone SOUTH
location-property LocationCode
discipline-property DisciplineCode
hierarchy-set Asset
hierarchy-source SafetyParent SupplyIsolationID
merge-runs PIP
site-from-assembly IfcStair
quantity-set Quantities
quantity-length Length
quantity-width Width
quantity-height Height
cull-set Quantities
duplicate-set Data
project-set Project
project-long-name PackageName
project-code PackageCode
building-name Zone
site-name Site
